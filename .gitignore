# Dependencies
node_modules/

# Build output
out/
release/
dist/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# GSD Core tooling — reinstall with:
#   npx @opengsd/gsd-core@latest --claude --local
# Kept out of the repo so 9.7 MB of MIT-licensed tooling does not dominate a
# GPL-3.0 project. It reappears under several names as editors are added; all of
# them are generated and belong out of the tree, or a `git add -A` sweeps them in.
.claude/
.agents/
.codex/

# Planning and design notes stay local. They carry precise file:line references
# to weaknesses in this codebase — some fixed, some not — and shipping that
# alongside the source of a security tool hands an attacker a map. Removed from
# history before the repo went public; keep it that way.
.planning/

# Never commit a vault or a recovery key, wherever one lands
vault.enc
vault.enc.*
prefs.json
*-recovery-key.txt
*obnovovaci-klic*.txt
