# GPL-3.0 project. The project's own specification lives in .planning/, which
# IS committed.
.claude/

# Never commit a vault or a recovery key, wherever one lands
vault.enc
vault.enc.*
prefs.json
*-recovery-key.txt
*obnovovaci-klic*.txt
